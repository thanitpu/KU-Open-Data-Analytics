{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ku2d.local/schemas/adapter-registry.v1.schema.json",
  "title": "KU2D Adapter Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "registry_id", "registry_version", "connector_contract_version", "registrations", "boundaries"],
  "properties": {
    "schema": {"const": "ku2d.adapter-registry.v1"},
    "registry_id": {"type": "string", "minLength": 1},
    "registry_version": {"const": "1.0.0"},
    "connector_contract_version": {"const": "1.0.0"},
    "registrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_manifest_id", "adapter_id", "adapter_version", "parser_id", "parser_version", "mapper_id", "mapper_version", "connector_contract_version", "implementation_key", "manifest_bindings", "supported_capabilities", "transport_modes"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "source_manifest_id": {"type": "string", "minLength": 1},
          "adapter_id": {"type": "string", "minLength": 1},
          "adapter_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "parser_id": {"type": "string", "minLength": 1},
          "parser_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "mapper_id": {"type": "string", "minLength": 1},
          "mapper_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "connector_contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "implementation_key": {"type": "string", "minLength": 1},
          "manifest_bindings": {
            "type": "object",
            "additionalProperties": false,
            "required": ["adapter", "parser", "mapper"],
            "properties": {
              "adapter": {"type": "string", "minLength": 1},
              "parser": {"type": "string", "minLength": 1},
              "mapper": {"type": "string", "minLength": 1}
            }
          },
          "supported_capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "transport_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["fixture_replay", "live_official_api"]}}
        }
      }
    },
    "boundaries": {
      "const": {"dynamic_imports": false, "production_approved": false, "scheduler_action": null}
    }
  }
}

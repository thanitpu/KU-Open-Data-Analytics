{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ku2d.local/schemas/minimum-trusted-connection-assessment.v1.schema.json",
  "title": "KU2D Minimum Trusted Connection Assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "assessment_id", "source_manifest_id", "assessed_at", "status", "useful_capabilities", "criteria", "record_count", "known_limitations", "closure_status", "boundaries"],
  "properties": {
    "schema": {"const": "ku2d.minimum-trusted-connection-assessment.v1"},
    "assessment_id": {"type": "string", "minLength": 1},
    "source_manifest_id": {"type": "string", "minLength": 1},
    "assessed_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["passed", "withheld", "failed"]},
    "useful_capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["useful_reproducible_capability", "schema_valid_output", "provenance", "failure_classification", "sanitized_evidence", "fixture_replay", "known_limitations"],
      "properties": {
        "useful_reproducible_capability": {"type": "boolean"},
        "schema_valid_output": {"type": "boolean"},
        "provenance": {"type": "boolean"},
        "failure_classification": {"type": "boolean"},
        "sanitized_evidence": {"type": "boolean"},
        "fixture_replay": {"type": "boolean"},
        "known_limitations": {"type": "boolean"}
      }
    },
    "record_count": {"type": "integer", "minimum": 0},
    "known_limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "closure_status": {"enum": ["open", "closed_v1"]},
    "boundaries": {"const": {"semantic_quality_claimed": false, "production_store": false, "production_approved": false, "scheduler_action": null}}
  }
}

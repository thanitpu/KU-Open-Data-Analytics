{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ku2d.local/schemas/adapter-registry-catalog.v1.schema.json",
  "title": "KU2D Adapter Registry Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "catalog_id", "catalog_version", "snapshots", "boundaries"],
  "properties": {
    "schema": {"const": "ku2d.adapter-registry-catalog.v1"},
    "catalog_id": {"type": "string", "minLength": 1},
    "catalog_version": {"const": "1.0.0"},
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["registry_id", "registry_version", "path", "sha256", "supersedes_registry_id"],
        "properties": {
          "registry_id": {"type": "string", "minLength": 1},
          "registry_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "supersedes_registry_id": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]}
        }
      }
    },
    "boundaries": {"const": {"default_to_latest": false, "dynamic_discovery": false, "production_approved": false, "scheduler_action": null}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ku2d.local/schemas/source-manifest.v1.schema.json",
  "title": "KU2D Source Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "manifest_id", "source_id", "provider", "domain_profile_id", "adapter", "parser", "mapper", "access_surface", "capabilities", "known_limitations", "fixture_sets", "evidence_refs", "integration_status", "boundaries"],
  "properties": {
    "schema": {"const": "ku2d.source-manifest.v1"},
    "manifest_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "domain_profile_id": {"type": "string", "minLength": 1},
    "adapter": {"type": "string", "minLength": 1},
    "parser": {"type": "string", "minLength": 1},
    "mapper": {"type": "string", "minLength": 1},
    "access_surface": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "state"],
        "properties": {
          "capability_id": {"type": "string", "minLength": 1},
          "state": {"enum": ["available", "partial", "unverified", "blocked", "unsupported", "not_applicable"]}
        }
      }
    },
    "known_limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "fixture_sets": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "integration_status": {"enum": ["source_lab", "minimum_trusted_connection", "integrated", "closed_v1"]},
    "boundaries": {
      "const": {"provider_requests_performed": 0, "documented_quota_units": 0, "production_store": false, "production_approved": false, "scheduler_action": null}
    }
  }
}

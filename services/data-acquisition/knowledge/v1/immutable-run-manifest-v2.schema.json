{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ku2d.local/schemas/immutable-run-manifest.v2.schema.json",
  "title": "KU2D Immutable Run Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "manifest_id", "manifest_version", "run_id", "created_at", "execution_started_at", "source_manifest", "adapter", "domain_capability_profile", "requested_capabilities", "transport", "fixture_references", "evidence_references", "request_policy", "integrity", "authority_boundaries", "immutability"],
  "properties": {
    "schema": {"const": "ku2d.immutable-run-manifest.v2"},
    "manifest_id": {"type": "string", "pattern": "^KU2D-RM-[0-9]{6}-V[0-9]{3}$"},
    "manifest_version": {"const": "2.0.0"},
    "run_id": {"type": "string", "pattern": "^KU2D-RUN-[0-9]{6}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "execution_started_at": {"type": "string", "format": "date-time"},
    "source_manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_id", "path", "sha256"],
      "properties": {"manifest_id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "adapter": {
      "type": "object", "additionalProperties": false,
      "required": ["registry_id", "registry_version", "adapter_id", "adapter_version", "parser_id", "parser_version", "mapper_id", "mapper_version", "connector_contract_version"],
      "properties": {
        "registry_id": {"type": "string", "minLength": 1}, "registry_version": {"const": "2.0.0"},
        "adapter_id": {"type": "string", "minLength": 1}, "adapter_version": {"type": "string", "minLength": 1},
        "parser_id": {"type": "string", "minLength": 1}, "parser_version": {"type": "string", "minLength": 1},
        "mapper_id": {"type": "string", "minLength": 1}, "mapper_version": {"type": "string", "minLength": 1},
        "connector_contract_version": {"const": "1.0.0"}
      }
    },
    "domain_capability_profile": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "version", "path", "sha256"],
      "properties": {"profile_id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "requested_capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "transport": {"type": "object", "additionalProperties": false, "required": ["mode", "fixture_id"], "properties": {"mode": {"const": "fixture_replay"}, "fixture_id": {"type": "string", "minLength": 1}}},
    "fixture_references": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["fixture_id", "path", "sha256"], "properties": {"fixture_id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "evidence_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "request_policy": {"const": {"maximum_attempts_per_capability": 1, "maximum_provider_requests": 0, "maximum_documented_quota_units": 0, "credential_required": false, "allow_live_provider": false}},
    "integrity": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter_registry_catalog_path", "adapter_registry_catalog_sha256", "adapter_registry_path", "adapter_registry_sha256"],
      "properties": {
        "adapter_registry_catalog_path": {"type": "string", "minLength": 1},
        "adapter_registry_catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "adapter_registry_path": {"type": "string", "minLength": 1},
        "adapter_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "authority_boundaries": {"const": {"semantic_quality_owner": "analysis", "production_store": false, "production_approved": false, "scheduler_action": null}},
    "immutability": {
      "type": "object", "additionalProperties": false,
      "required": ["executed_manifest_mutation_allowed", "correction_mode", "supersedes_manifest_id"],
      "properties": {
        "executed_manifest_mutation_allowed": {"const": false},
        "correction_mode": {"const": "new_manifest_version"},
        "supersedes_manifest_id": {"type": "string", "pattern": "^KU2D-RM-[0-9]{6}-V[0-9]{3}$"}
      }
    }
  }
}

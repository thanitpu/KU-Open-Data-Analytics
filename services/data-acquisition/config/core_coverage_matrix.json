    {"capability_id": "CK-CAP-SITEMAP-STATIC", "capability": "Sitemap and static discovery", "state": "validated_multi_source", "evidence_references": ["config/supermarket_acquisition_patterns.json", "docs/SUPERMARKET_ACQUISITION_PATTERN_LIBRARY.md"], "gap": "Sitemap presence alone does not establish detail-page quality or freshness."},
    {"capability_id": "CK-CAP-CANONICAL-DETAIL", "capability": "Canonical detail extraction", "state": "validated_multi_source", "evidence_references": ["config/supermarket_acquisition_patterns.json", "config/retail_domain_validations.json"], "gap": "Variant identity remains source-specific and must not be inferred from product identity."},
    {"capability_id": "CK-CAP-RENDERED-DOM", "capability": "Rendered DOM extraction", "state": "validated_multi_source", "evidence_references": ["config/supermarket_acquisition_patterns.json", "config/lazada_commerce_pulse_sources.json"], "gap": "Rendered controls and category text still require semantic rejection gates."},
    {"capability_id": "CK-CAP-BROWSER", "capability": "Browser acquisition", "state": "partial", "evidence_references": ["config/lazada_commerce_pulse_sources.json", "config/shopee_commerce_pulse_sources.json"], "gap": "Browser success is source and environment specific; Shopee remains paused at traffic verification."},
    {"capability_id": "CK-CAP-APP-BUNDLE", "capability": "Application-bundle discovery", "state": "validated_single_source", "evidence_references": ["config/retail_domain_validations.json", "docs/SUPERMARKET_ACQUISITION_PATTERN_LIBRARY.md"], "gap": "Only JIB has domain-live validation; bundle clues never validate endpoint semantics by name."},
    {"capability_id": "CK-CAP-STRUCTURED-RESPONSE", "capability": "Structured response use", "state": "validated_multi_source", "evidence_references": ["config/supermarket_acquisition_patterns.json", "config/youtube_api_policy.json"], "gap": "Marketplace structured commerce responses remain unvalidated in the reviewed Shopee and Lazada evidence."},
    {"capability_id": "CK-CAP-PAGINATION", "capability": "Bounded pagination", "state": "partial", "evidence_references": ["docs/SUPERMARKET_ACQUISITION_PATTERN_LIBRARY.md", "docs/YOUTUBE_SOURCE_FOUNDATION.md"], "gap": "Coverage and stop conditions are not normalized across every source family."},
    {"capability_id": "CK-CAP-EXECUTION-ENV", "capability": "Execution-environment dependence", "state": "validated_single_source", "evidence_references": ["../../docs/validation/gourmet-access-environment-2026-08-29.json", "config/execution_environment_profiles.json"], "gap": "Gourmet is the durable positive split-environment case; environment transfer cannot be assumed."},
    {"capability_id": "CK-CAP-AUTH-BOUNDARY", "capability": "Authentication and access-control boundary handling", "state": "boundary_validated", "evidence_references": ["config/shopee_commerce_pulse_sources.json", "fixtures/lazada_browser_access/traffic_verification.json"], "gap": "Boundaries are safely classified, but blocked access does not identify a viable alternative technique."},
    {"capability_id": "CK-CAP-CHANGE-MONITORING", "capability": "Change monitoring", "state": "partial", "evidence_references": ["docs/ARCHITECTURE_v0.28.md", "docs/YOUTUBE_HUMAN_REVIEW.md"], "gap": "Profile fingerprints and refresh dates exist, but a common cross-domain drift-event contract is missing."},
    {"capability_id": "CK-CAP-INCREMENTAL-REFRESH", "capability": "Incremental refresh", "state": "partial", "evidence_references": ["docs/YOUTUBE_HUMAN_REVIEW.md", "config/youtube_knowledge_dataset_schema.json"], "gap": "Uploads-playlist planning is dry only, and commerce incremental refresh is not reviewed."},
    {"capability_id": "CK-CAP-ENTITY-RESOLUTION", "capability": "Entity resolution", "state": "partial", "evidence_references": ["config/lazada_commerce_pulse_sources.json", "config/retail_commerce_core_patterns.json"], "gap": "Stable product identity is supported, but product-to-variant equivalence remains unresolved."},
    {"capability_id": "CK-CAP-CROSS-SOURCE-MATCH", "capability": "Cross-source matching", "state": "gap", "evidence_references": ["config/lazada_commerce_pulse_sources.json", "config/retail_commerce_core_patterns.json"], "gap": "No reviewed cross-source identity-match corpus exists; same-source search/detail correlation is not cross-source matching."},
    {"capability_id": "CK-CAP-TEMPORAL-OBSERVATION", "capability": "Temporal observation", "state": "partial", "evidence_references": ["config/lazada_commerce_pulse_sources.json", "docs/SHOPEE_COMMERCE_PULSE.md"], "gap": "Lazada longitudinal readiness is partial and Shopee public observation is paused."},
    {"capability_id": "CK-CAP-SEMANTIC-NORMALIZATION", "capability": "Semantic normalization", "state": "validated_multi_source", "evidence_references": ["fixtures/acquisition_learning_memory/sanitized_historical_episodes.json", "config/retail_commerce_core_patterns.json"], "gap": "Unknown price roles, counters, and variants must continue to remain unknown until evidence resolves them."},
    {"capability_id": "CK-CAP-QUALITY-YIELD", "capability": "Quality and yield", "state": "validated_multi_source", "evidence_references": ["config/supermarket_acquisition_patterns.json", "config/retail_domain_validations.json"], "gap": "Quality gates are domain-specific, and record count alone must never substitute for semantic quality."},
    {"capability_id": "CK-CAP-PROVENANCE-REVIEW", "capability": "Provenance and review maturity", "state": "partial", "evidence_references": ["docs/ACQUISITION_LEARNING_MEMORY.md", "config/retail_domain_validations.json"], "gap": "Reviewed corpus authority is defined, but most historical episodes lack explicit Human Confirmation and none form an ML Training Dataset."},
    {"capability_id": "CK-CAP-REQUEST-COST", "capability": "Request cost and latency", "state": "partial", "evidence_references": ["config/youtube_api_policy.json", "docs/YOUTUBE_SOURCE_FOUNDATION.md"], "gap": "YouTube quota budgeting is evidenced; normalized actual request cost and latency evidence is otherwise absent."}
  ]
}

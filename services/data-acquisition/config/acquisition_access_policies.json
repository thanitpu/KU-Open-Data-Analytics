    "3": {"min_delay_seconds": 8.0, "max_pages_per_run": 8, "max_retries": 0, "default_cadence": "weekly", "continuous_allowed": false},
    "4": {"min_delay_seconds": 0.5, "max_pages_per_run": 100, "max_retries": 2, "default_cadence": "daily", "continuous_allowed": true, "note": "Actual limits must follow granted API/session policy."},
    "5": {"min_delay_seconds": 0, "max_pages_per_run": 0, "max_retries": 0, "default_cadence": "manual", "continuous_allowed": false}
